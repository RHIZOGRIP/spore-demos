extends RefCounted

var turn = 0
var stone = 24.0
var grain = 18.0
var gold = 0.0
var workers = 9
var jobs = [0,0,0]
var hp = [70.0,70.0,70.0]
var flooded = [false,false,false]
var gate_open = false
var ended = false
var won = false
var forecast = 0.0
var offer = false
var accepted = false
var last = {}
var tides = []
var debts = []
var rng = RandomNumberGenerator.new()
var config = {}
var seed_id = 0
var forced_bargain = -1
var bargain_count = 0
var oracle_actions = []

func setup(s:int):
	seed_id=s
	rng.seed=s+7291
	config=JSON.parse_string(FileAccess.get_file_as_string("res://balance.json"))
	turn=0; stone=config.stone; grain=config.grain; gold=0.0; workers=9
	jobs=[0,0,0]; hp=[config.hp,config.hp,config.hp]; flooded=[false,false,false]
	gate_open=false; ended=false; won=false; last={}; tides=[]; debts=[]; accepted=false; bargain_count=0
	for i in range(12):
		var height = rng.randf_range(2.0,5.2)+i*0.055
		if i==11: height=6.2
		var error=rng.randf_range(-config.error,config.error)
		var storm=-1
		if rng.randf()<config.storm_chance: storm=rng.randi_range(0,2)
		tides.append({"height":snappedf(height,0.1),"forecast":snappedf(clampf(height+error,1.5,6.5),0.1),"storm":storm,"strike":rng.randf_range(config.storm_min,config.storm_max),"offer":i>0 and i<9 and rng.randf()<0.40,"debt_section":rng.randi_range(0,2),"debt_damage":rng.randf_range(config.debt_min,config.debt_max)})
	refresh()

func refresh():
	if turn<12:
		forecast=tides[turn].forecast
		offer=tides[turn].offer
	accepted=false

func assign(index:int,delta:int)->bool:
	if ended or index<0 or index>2: return false
	if jobs[index]+delta<0 or jobs.reduce(func(a,b):return a+b,0)+delta>workers: return false
	jobs[index]+=delta
	return true

func hire()->bool:
	if gold<5 or workers>=12 or ended: return false
	gold-=5; workers+=1
	return true

func peek()->Dictionary:
	if turn>=12: return {"height":6.2,"storm":-1}
	return tides[turn].duplicate()

func visible()->Dictionary:
	return {"turn":turn,"stone":stone,"grain":grain,"gold":gold,"workers":workers,"jobs":jobs.duplicate(),"hp":hp.duplicate(),"flooded":flooded.duplicate(),"forecast":forecast,"offer":offer,"bargain_sign":bargain_sign(),"gate_open":gate_open}

func lowest()->int:
	for i in range(3):
		if not flooded[i]: return i
	return -1

func weakest()->int:
	var k=-1
	for i in range(3):
		if not flooded[i] and (k<0 or hp[i]<hp[k]): k=i
	return k

func flood(i:int,events:Array,new_floods:Array):
	if i>=0 and not flooded[i]:
		flooded[i]=true; hp[i]=0.0; new_floods.append(i)
		events.append(["Harbour","Market","Sanctuary"][i]+" is lost to the sea.")

func resolve():
	if ended: return
	var t=tides[turn]
	var events=[]
	var new_floods=[]
	var damage=[0.0,0.0,0.0]
	if accepted and offer:
		stone+=config.gift_stone; grain+=config.gift_grain; gold+=config.gift_gold
		debts.append({"due":turn+2,"section":t.debt_section,"damage":t.debt_damage})
		bargain_count+=1
		events.append("The stranger pays. Somewhere bronze turns brittle.")
	# Each flooded district permanently removes the configured share of capacity.
	var productivity=1.0-flooded.count(true)*config.loss
	stone+=jobs[0]*config.quarry*productivity
	grain+=jobs[1]*config.fields*productivity
	for _j in range(jobs[2]):
		var k=weakest()
		if k>=0 and stone>=config.repair_cost:
			var needed=minf(config.repair,100.0-hp[k])
			if needed>0:
				stone-=config.repair_cost*(needed/config.repair)
				hp[k]+=needed
	for d in debts:
		if d.due==turn and not flooded[d.section]:
			hp[d.section]-=d.damage; damage[d.section]+=d.damage
			events.append("Hidden fractures open in section "+str(d.section+1)+".")
	if gate_open:
		gold+=config.trade
		if t.height>=4.0:
			flood(lowest(),events,new_floods)
		else: events.append("Ships bring "+str(int(config.trade))+" gold through the bronze gate.")
	for i in range(3):
		if flooded[i]: continue
		var hit=config.wear+t.height*config.pressure+flooded.count(true)*config.cascade
		if t.storm==i:
			hit+=t.strike
			events.append("A storm strikes section "+str(i+1)+".")
		hp[i]-=hit; damage[i]+=hit
		if hp[i]<=0: flood(i,events,new_floods)
	var missing=maxi(0,workers-int(floor(grain)))
	grain=maxf(0,grain-workers)
	if missing>0:
		workers-=missing
		events.append(str(missing)+" unfed workers leave Ys.")
		while jobs[0]+jobs[1]+jobs[2]>workers:
			var idx=jobs.find(jobs.max()); jobs[idx]-=1
	turn+=1
	ended=flooded.count(true)==3 or turn>=12
	won=turn>=12 and flooded.count(false)>0
	last={"height":t.height,"storm":t.storm,"damage":damage,"events":events,"flooded":new_floods}
	refresh()

func policy(kind:String):
	if kind=="seer":
		assert(turn<oracle_actions.size(),"Seer requires a full-future plan generated by planner/search.py")
		var a=oracle_actions[turn]
		for _h in range(int(a.hires)):
			assert(hire(),"Illegal oracle hire")
		jobs=[int(a.jobs[0]),int(a.jobs[1]),int(a.jobs[2])]
		gate_open=a.gate;accepted=a.bargain
		return
	if kind=="seer_local":
		seer_plan()
		return
	if kind=="idle": return
	if kind=="greedy":
		while hire(): pass
		jobs=[int(workers/3.0),int(workers/3.0),workers-2*int(workers/3.0)]
		gate_open=true; accepted=offer
		return
	var oracle=kind=="oracle_basic"
	var level=tides[turn].height if oracle else forecast
	gate_open=level<config.open_below
	if kind=="steward_closed": gate_open=false
	while hire(): pass
	var productivity=1.0-flooded.count(true)*config.loss
	var food_need=maxf(0,(workers*1.65-grain)/(config.fields*productivity))
	var f=clampi(int(ceil(food_need)),0,workers)
	var repair_need=0.0
	for i in range(3):
		if not flooded[i]:
			var predicted=config.wear+level*config.pressure
			if oracle and tides[turn].storm==i: predicted+=tides[turn].strike
			repair_need+=maxf(0,config.goal+predicted-hp[i])
	var d=clampi(int(ceil(repair_need/config.repair)),1,workers-f)
	var q=clampi(int(ceil(maxf(0,d*config.repair_cost+config.stock-stone)/(config.quarry*productivity))),0,workers-f)
	# Finance today's masonry, don't promise repairs without stone.
	d=mini(d,workers-f-q)
	q=workers-f-d
	jobs=[q,f,d]
	if kind=="steward_no_repair": jobs=[q+d,f,0]
	# No hidden tide/debt inspection: this selective decision reads the same
	# noisy voice cue and current resources/walls that are shown to the player.
	var need_supplies=stone<36 or grain<workers*2.0
	accepted=offer and bargain_sign()=="warm" and need_supplies
	if oracle and offer:
		var k=tides[turn].debt_section
		accepted=accepted and (flooded[k] or tides[turn].debt_damage<config.oracle_debt)
	if forced_bargain==0: accepted=false
	if forced_bargain==1: accepted=offer

# The seer compares visible-style plans against the actual entire future.
# Only this bot receives tides and concealed debt amounts in its rollouts.
func clone_state():
	var r=get_script().new()
	r.config=config; r.tides=tides; r.turn=turn; r.seed_id=seed_id
	r.stone=stone; r.grain=grain; r.gold=gold; r.workers=workers
	r.jobs=jobs.duplicate(); r.hp=hp.duplicate(); r.flooded=flooded.duplicate()
	r.debts=debts.duplicate(true); r.forecast=forecast; r.offer=offer
	r.gate_open=gate_open; r.accepted=accepted; r.ended=ended; r.won=won
	return r

func seer_plan():
	policy("oracle_basic")
	var base=jobs.duplicate()
	var options=[base]
	for a in range(3):
		for b in range(3):
			if a!=b and base[a]>0:
				var alternative=base.duplicate(); alternative[a]-=1; alternative[b]+=1
				options.append(alternative)
	var best_score=-1e20
	var choice={"jobs":base,"gate":gate_open,"accept":accepted}
	for allocation in options:
		for gate in [false,true]:
			for bargain in ([false,true] if offer else [false]):
				var trial=clone_state()
				trial.jobs=allocation.duplicate(); trial.gate_open=gate; trial.accepted=bargain
				trial.resolve()
				while not trial.ended:
					trial.policy("oracle_basic"); trial.resolve()
				var score=(10000.0 if trial.won else 0.0)+trial.turn*100.0+trial.hp.reduce(func(a,b):return a+b,0.0)+trial.workers*3.0
				if score>best_score:
					best_score=score; choice={"jobs":allocation,"gate":gate,"accept":bargain}
	jobs=choice.jobs.duplicate(); gate_open=choice.gate; accepted=choice.accept

# The stranger's voice is an imperfect public omen, not a damage readout.
# Forecast noise masks the cue; neither exact weakening nor its target is shown.
# Derivation consumes no new RNG draws, preserving all existing seeded tides.
func bargain_sign()->String:
	if not offer or turn>=12:return "absent"
	var t=tides[turn]
	var impression=t.debt_damage+(t.forecast-t.height)*18.0
	if impression<60.0:return "warm"
	if impression<80.0:return "wavering"
	return "hollow"
